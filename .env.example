# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/cyberdefend_db?schema=public"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Application Configuration
NODE_ENV="development"
PORT="3000"
FRONTEND_URL="http://localhost:3001"

# AWS Configuration
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="cyberdefend-storage"

# Email Configuration (Legacy SMTP - keeping for backward compatibility)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@cyberdefend360.com"

# Mailtrap Configuration (Notification Module)
# For SANDBOX (Testing) - No domain verification required:
MAILTRAP_LIVE_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_BULK_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_SMTP_PORT="2525"
MAILTRAP_SMTP_USER="your-mailtrap-username"
MAILTRAP_SMTP_PASS="your-mailtrap-password"
MAILTRAP_FROM_EMAIL="noreply@cyber360.tech"
MAILTRAP_FROM_NAME="CyberDefend 360"

# For PRODUCTION - Requires domain verification:
# MAILTRAP_LIVE_HOST="live.smtp.mailtrap.io"
# MAILTRAP_BULK_HOST="bulk.smtp.mailtrap.io"
# MAILTRAP_SMTP_PORT="587"
# MAILTRAP_SMTP_USER="api"
# MAILTRAP_SMTP_PASS="your-api-token"
# MAILTRAP_API_TOKEN="your-mailtrap-api-token-here"
# MAILTRAP_FROM_EMAIL="noreply@cyber360.tech"
# MAILTRAP_FROM_NAME="CyberDefend 360"


# Arkesel SMS Configuration (Notification Module)
ARKESEL_API_KEY="your-arkesel-api-key-here"
ARKESEL_SENDER_ID="CyberDefend"
ARKESEL_BASE_URL="https://sms.arkesel.com/api/v2"

# Payment Gateway Configuration
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your_flutterwave_secret_key"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-your_flutterwave_public_key"

# External Services
GHANA_POST_GPS_API_KEY="your-gps-api-key"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Security
ENCRYPTION_KEY="your-32-char-encryption-key-here"
BCRYPT_ROUNDS="12"

# Monitoring
SENTRY_DSN="your-sentry-dsn"
LOG_LEVEL="debug"