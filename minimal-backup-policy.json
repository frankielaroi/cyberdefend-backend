{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowS3ListBucketsForBackups",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::myapp-backups-prod-*"
            ]
        },
        {
            "Sid": "AllowS3ObjectAccessForBackups",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::myapp-backups-prod-*/*"
            ]
        }
    ]
}