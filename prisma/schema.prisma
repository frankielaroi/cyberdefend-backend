generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                    String                  @id @default(uuid())
  email                                 String                  @unique
  password                              String
  firstName                             String
  lastName                              String
  phone                                 String?
  avatar                                String?
  emailVerified                         Boolean                 @default(false)
  isActive                              Boolean                 @default(true)
  role                                  UserRole                @default(END_USER)
  createdAt                             DateTime                @default(now())
  updatedAt                             DateTime                @updatedAt
  organizationId                        String?
  verificationToken                     String?
  transferredAssessments                Assessment[]            @relation("TransferredAssessments")
  auditLogs                             AuditLog[]
  emailTracking                         EmailTracking[]
  createdInviteCodes                    InviteCode[]
  notificationHistory                   NotificationHistory[]
  notificationPreferences               NotificationPreference?
  sentInvites                           OrganizationMember[]    @relation("UserInvites")
  organizationMemberships               OrganizationMember[]
  passwordResets                        PasswordReset[]
  phishingCampaigns                     PhishingCampaign[]      @relation("CampaignCreator")
  phishingTargets                       PhishingTarget[]
  phishingTemplates                     PhishingTemplate[]      @relation("TemplateCreator")
  refreshTokens                         RefreshToken[]
  telemetryEvents                       TelemetryEvent[]
  organization                          Organization?           @relation(fields: [organizationId], references: [id])

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Organization {
  id                String               @id @default(uuid())
  name              String
  email             String?              @unique
  phone             String?
  website           String?
  description       String?
  logo              String?
  address           String?
  city              String?
  region            String?
  country           String               @default("Ghana")
  gpsAddress        String?
  size              OrganizationSize
  sector            Sector
  isPublic          Boolean              @default(false)
  csiScore          Float?
  riskTier          RiskTier?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  agents            Agent[]
  assessments       Assessment[]
  inviteCodes       InviteCode[]
  invoices          Invoice[]
  members           OrganizationMember[]
  phishingCampaigns PhishingCampaign[]
  phishingTemplates PhishingTemplate[]
  subscriptions     Subscription[]
  users             User[]

  @@map("organizations")
}

model InviteCode {
  id             String       @id @default(uuid())
  code           String       @unique
  organizationId String
  createdBy      String
  expiresAt      DateTime
  usageLimit     Int          @default(10)
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  email          String?
  creator        User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invite_codes")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           UserRole     @default(END_USER)
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  invitedBy      String?
  inviteCode     String?
  inviter        User?        @relation("UserInvites", fields: [invitedBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model Assessment {
  id                              String               @id @default(uuid())
  title                           String
  description                     String?
  type                            AssessmentType       @default(CSI_ASSESSMENT)
  status                          AssessmentStatus     @default(DRAFT)
  score                           Float?
  maxScore                        Float?
  riskTier                        RiskTier?
  benchmarkRegion                 Float?
  benchmarkSector                 Float?
  benchmarkSize                   Float?
  startedAt                       DateTime?
  completedAt                     DateTime?
  reportUrl                       String?
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt
  organizationId                  String?
  expiresAt                       DateTime?
  isAnonymous                     Boolean              @default(false)
  sessionId                       String?              @unique
  transferredToUserId             String?
  responses                       AssessmentResponse[]
  result                          AssessmentResult?
  organization                    Organization?        @relation(fields: [organizationId], references: [id])
  transferredToUser               User?                @relation("TransferredAssessments", fields: [transferredToUserId], references: [id])

  @@map("assessments")
}

model QuestionCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  weight      Float      @default(1.0)
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]

  @@map("question_categories")
}

model Question {
  id              String               @id @default(uuid())
  text            String
  description     String?
  type            QuestionType
  weight          Float                @default(1.0)
  isRequired      Boolean              @default(true)
  order           Int                  @default(0)
  isActive        Boolean              @default(true)
  version         String               @default("1.0")
  dependsOnAnswer String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  categoryId      String
  responses       AssessmentResponse[]
  options         QuestionOption[]
  category        QuestionCategory     @relation(fields: [categoryId], references: [id])

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  text       String
  value      String
  score      Float
  order      Int      @default(0)
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model AssessmentResponse {
  id           String     @id @default(uuid())
  answer       String
  score        Float?
  timeSpent    Int?
  createdAt    DateTime   @default(now())
  assessmentId String
  questionId   String
  sessionId    String?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
  @@index([sessionId])
  @@map("assessment_responses")
}

model AssessmentResult {
  id                 String     @id @default(uuid())
  overallScore       Float
  overallPercentage  Float
  tier               CSITier
  categoryScores     String
  sectionScores      String
  industryPercentile Float?
  sizePercentile     Float?
  regionPercentile   Float?
  questionsAnswered  Int
  totalQuestions     Int
  completionRate     Float
  totalTimeMinutes   Int?
  generatedAt        DateTime   @default(now())
  assessmentId       String     @unique
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_results")
}

model PhishingCampaign {
  id                 String           @id @default(uuid())
  name               String
  description        String?
  template           String
  subject            String
  senderName         String
  senderEmail        String
  landingPageUrl     String?
  status             CampaignStatus   @default(DRAFT)
  scheduledAt        DateTime?
  completedAt        DateTime?
  targetCount        Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organizationId     String
  createdBy          String
  credentialsEntered Int              @default(0)
  emailsBounced      Int              @default(0)
  emailsDelivered    Int              @default(0)
  emailsOpened       Int              @default(0)
  emailsSent         Int              @default(0)
  launchedAt         DateTime?
  linksClicked       Int              @default(0)
  pausedAt           DateTime?
  phishingReported   Int              @default(0)
  templateId         String
  emailTracking      EmailTracking[]
  creator            User             @relation("CampaignCreator", fields: [createdBy], references: [id])
  organization       Organization     @relation(fields: [organizationId], references: [id])
  events             PhishingEvent[]
  targets            PhishingTarget[]

  @@map("phishing_campaigns")
}

model PhishingTarget {
  id                 String           @id @default(uuid())
  email              String
  firstName          String?
  lastName           String?
  department         String?
  deliveredAt        DateTime?
  openedAt           DateTime?
  clickedAt          DateTime?
  reportedAt         DateTime?
  createdAt          DateTime         @default(now())
  campaignId         String
  userId             String?
  bouncedAt          DateTime?
  clickCount         Int              @default(0)
  credentialsAt      DateTime?
  credentialsEntered Boolean          @default(false)
  emailBounced       Boolean          @default(false)
  emailDelivered     Boolean          @default(false)
  emailOpened        Boolean          @default(false)
  emailSent          Boolean          @default(false)
  ipAddress          String?
  jobTitle           String?
  linkClicked        Boolean          @default(false)
  reportedPhishing   Boolean          @default(false)
  riskScore          Float?
  sentAt             DateTime?
  updatedAt          DateTime         @updatedAt
  userAgent          String?
  events             PhishingEvent[]
  campaign           PhishingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user               User?            @relation(fields: [userId], references: [id])

  @@unique([campaignId, email])
  @@map("phishing_targets")
}

model PhishingEvent {
  id         String            @id @default(uuid())
  type       PhishingEventType
  metadata   String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime          @default(now())
  campaignId String
  targetId   String?
  location   String?
  campaign   PhishingCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  target     PhishingTarget?   @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@map("phishing_events")
}

model PhishingTemplate {
  id                 String           @id @default(uuid())
  name               String           @unique
  description        String
  category           TemplateCategory
  riskLevel          RiskLevel
  defaultSubject     String
  defaultSenderName  String
  emailBodyHtml      String
  emailBodyText      String
  landingPageHtml    String?
  captureCredentials Boolean          @default(false)
  isActive           Boolean          @default(true)
  previewContent     String
  tags               String[]
  usageCount         Int              @default(0)
  successRate        Float?
  createdBy          String?
  organizationId     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  creator            User?            @relation("TemplateCreator", fields: [createdBy], references: [id])
  organization       Organization?    @relation(fields: [organizationId], references: [id])

  @@map("phishing_templates")
}

model EmailJob {
  id             String      @id @default(uuid())
  campaignId     String
  targetId       String
  priority       JobPriority @default(MEDIUM)
  scheduledFor   DateTime
  attempts       Int         @default(0)
  maxAttempts    Int         @default(3)
  status         JobStatus   @default(PENDING)
  processingData String?
  errorMessage   String?
  lastAttemptAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("email_jobs")
}

model Agent {
  id              String           @id @default(uuid())
  name            String
  version         String
  osType          String
  osVersion       String
  hostname        String
  ipAddress       String?
  macAddress      String?
  isActive        Boolean          @default(true)
  lastSeen        DateTime         @default(now())
  apiKey          String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  alerts          Alert[]
  scanResults     ScanResult[]
  telemetryEvents TelemetryEvent[]

  @@map("agents")
}

model TelemetryEvent {
  id        String        @id @default(uuid())
  type      TelemetryType
  source    String
  data      String
  severity  SeverityLevel @default(INFO)
  timestamp DateTime      @default(now())
  agentId   String
  userId    String?
  agent     Agent         @relation(fields: [agentId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])

  @@map("telemetry_events")
}

model DetectionRule {
  id          String        @id @default(uuid())
  name        String
  description String?
  condition   String
  action      RuleAction    @default(ALERT)
  severity    SeverityLevel @default(MEDIUM)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  alerts      Alert[]

  @@map("detection_rules")
}

model Alert {
  id             String        @id @default(uuid())
  title          String
  description    String
  severity       SeverityLevel
  status         AlertStatus   @default(OPEN)
  data           String?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime      @default(now())
  ruleId         String
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id])
  rule           DetectionRule @relation(fields: [ruleId], references: [id])

  @@map("alerts")
}

model ScanResult {
  id              String     @id @default(uuid())
  type            ScanType
  status          ScanStatus @default(PENDING)
  score           String?
  findings        String
  recommendations String?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  reportUrl       String?
  agentId         String
  agent           Agent      @relation(fields: [agentId], references: [id])

  @@map("scan_results")
}

model SubscriptionPlan {
  id             String           @id @default(uuid())
  name           String           @unique
  description    String?
  features       String
  price          Float
  currency       String           @default("GHS")
  type           SubscriptionType
  isActive       Boolean          @default(true)
  trialDays      Int              @default(0)
  maxUsers       Int?
  maxAssessments Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  subscriptions  Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  status             SubscriptionStatus @default(TRIAL)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  trialEndDate       DateTime?
  autoRenew          Boolean            @default(true)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organizationId     String
  planId             String
  invoices           Invoice[]
  organization       Organization       @relation(fields: [organizationId], references: [id])
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  amount         Float
  currency       String        @default("GHS")
  status         InvoiceStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  description    String?
  metadata       String?
  receiptUrl     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String
  subscriptionId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  payments       Payment[]

  @@map("invoices")
}

model Payment {
  id          String          @id @default(uuid())
  amount      Float
  currency    String          @default("GHS")
  method      PaymentMethod
  provider    PaymentProvider
  providerRef String
  status      PaymentStatus   @default(PENDING)
  metadata    String?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model BenchmarkData {
  id        String           @id @default(uuid())
  region    String
  sector    Sector
  size      OrganizationSize
  avgScore  Float
  totalOrgs Int
  period    String
  createdAt DateTime         @default(now())

  @@unique([region, sector, size, period])
  @@map("benchmark_data")
}

model NotificationHistory {
  id            String             @id @default(uuid())
  type          NotificationType
  recipient     String
  subject       String?
  content       String
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  lastAttempt   DateTime?
  sentAt        DateTime?
  error         String?
  jobId         String?
  messageId     String?
  metadata      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  userId        String?
  emailTracking EmailTracking[]
  user          User?              @relation(fields: [userId], references: [id])

  @@map("notification_history")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  subject     String
  htmlContent String
  textContent String?
  variables   String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

model NotificationPreference {
  id                String   @id @default(uuid())
  emailEnabled      Boolean  @default(true)
  smsEnabled        Boolean  @default(false)
  pushEnabled       Boolean  @default(true)
  securityAlerts    Boolean  @default(true)
  assessmentUpdates Boolean  @default(true)
  systemUpdates     Boolean  @default(false)
  marketingEmails   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model EmailTracking {
  id                    String               @id @default(uuid())
  trackingId            String               @unique
  recipientEmail        String
  emailSubject          String?
  emailType             String?
  sentAt                DateTime             @default(now())
  openedAt              DateTime?
  openCount             Int                  @default(0)
  lastOpenedAt          DateTime?
  ipAddress             String?
  userAgent             String?
  location              String?
  deviceType            String?
  userId                String?
  notificationHistoryId String?
  phishingCampaignId    String?
  metadata              String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  notificationHistory   NotificationHistory? @relation(fields: [notificationHistoryId], references: [id])
  phishingCampaign      PhishingCampaign?    @relation(fields: [phishingCampaignId], references: [id])
  user                  User?                @relation(fields: [userId], references: [id])

  @@index([trackingId])
  @@index([recipientEmail])
  @@index([sentAt])
  @@map("email_tracking")
}

enum UserRole {
  SUPER_ADMIN
  CSA_ADMIN
  ORG_ADMIN
  ORG_MANAGER
  END_USER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum OrganizationSize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum Sector {
  BANKING
  TELECOMMUNICATIONS
  INSURANCE
  GOVERNMENT
  HEALTHCARE
  EDUCATION
  ENERGY
  MANUFACTURING
  RETAIL
  LOGISTICS
  TECHNOLOGY
  NGO
  OTHER
}

enum RiskTier {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum AssessmentType {
  CSI_ASSESSMENT
  COMPLIANCE_CHECK
  SECURITY_AUDIT
  BASELINE_ASSESSMENT
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  SCALE
  TEXT
  FILE_UPLOAD
}

enum CSITier {
  BASIC
  FOUNDATIONAL
  ORGANIZATIONAL
  ADVANCED
  PROGRESSIVE
  INNOVATIVE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum PhishingEventType {
  EMAIL_QUEUED
  EMAIL_SENT
  EMAIL_DELIVERED
  EMAIL_BOUNCED
  EMAIL_OPENED
  LINK_CLICKED
  CREDENTIALS_ENTERED
  PHISHING_REPORTED
  CAMPAIGN_STARTED
  CAMPAIGN_PAUSED
  CAMPAIGN_RESUMED
  CAMPAIGN_COMPLETED
  CAMPAIGN_CANCELLED
}

enum TemplateCategory {
  SECURITY
  HR
  FINANCE
  IT
  EXECUTIVE
  GENERAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum TelemetryType {
  LOGIN_ATTEMPT
  LOGIN_SUCCESS
  LOGIN_FAILURE
  FILE_ACCESS
  PROCESS_START
  NETWORK_CONNECTION
  ANTIVIRUS_EVENT
  SYSTEM_CHANGE
  SECURITY_ALERT
  APPLICATION_EVENT
}

enum SeverityLevel {
  LOW
  INFO
  MEDIUM
  HIGH
  CRITICAL
}

enum RuleAction {
  ALERT
  BLOCK
  LOG
  EMAIL
  SMS
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

enum ScanType {
  VULNERABILITY_SCAN
  MALWARE_SCAN
  COMPLIANCE_SCAN
  CONFIGURATION_SCAN
  NETWORK_SCAN
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SubscriptionType {
  DEFEND_CORE
  DEFEND_VAULT
  DEFEND_CLICK
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  PAYPAL
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRY
  CANCELLED
}
