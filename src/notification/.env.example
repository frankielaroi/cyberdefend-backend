# Notification Module Environment Variables

# Mailtrap Configuration (using API instead of SMTP)
MAILTRAP_API_TOKEN=your_mailtrap_api_token_here
MAILTRAP_FROM_EMAIL=noreply@cyber360.tech
MAILTRAP_FROM_NAME=CyberDefend

# Arkesel SMS Configuration
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=CyberDefend
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

# Redis Configuration (should already be configured)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Additional settings (optional)
# NOTIFICATION_MAX_RETRY_ATTEMPTS=3
# NOTIFICATION_RETRY_DELAY=5000
# EMAIL_BATCH_SIZE=100
# SMS_BATCH_SIZE=5